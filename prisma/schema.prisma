generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Caregiver {
  id            String    @id @default(cuid())
  name          String
  licenseNumber String?
  kakaoId       String?   @unique
  // OPS-1 체험 계정: demoExpiresAt이 지나면 수급자·방문 기록과 함께 지운다
  isDemo        Boolean   @default(false)
  demoExpiresAt DateTime?
  // LAW-3 동의 기록: 동의한 시각과 항목 키(쉼표로 이음, app/v1120/_consent.ts)
  consentedAt   DateTime?
  consentItems  String?
  visits        Visit[]
  clients       Client[]
  aiUsages      AiUsage[]
}

// SEC-3 AI 호출 기록. 요양보호사마다 시간당·하루 호출 수를 센다 (lib/aiLimit.ts)
model AiUsage {
  id          String    @id @default(cuid())
  caregiverId String
  caregiver   Caregiver @relation(fields: [caregiverId], references: [id])
  kind        String
  createdAt   DateTime  @default(now())

  @@index([caregiverId, createdAt])
}

model Client {
  id                     String           @id @default(cuid())
  name                   String
  age                    Int?
  gender                 String?
  allergies              String?
  medicalHistory         String?
  medicationNotes        String?
  personalNotes          String?
  guardianName           String
  guardianRelation       String           @default("기타")
  guardianPhone          String?
  careRegistrationNumber String?
  careGrade              String?
  phone                  String?
  scheduleLabel          String?
  isActive               Boolean          @default(true)
  purgeAt                DateTime?
  // SEC-2: 담당 요양보호사. 1120 화면은 이 값으로 거른다. 옛 화면이 만든 수급자는 비어 있을 수 있다
  caregiverId            String?
  caregiver              Caregiver?       @relation(fields: [caregiverId], references: [id])
  visits                 Visit[]
  documents              SharedDocument[]
}

model Visit {
  id          String      @id @default(cuid())
  caregiverId String
  caregiver   Caregiver   @relation(fields: [caregiverId], references: [id])
  clientId    String
  client      Client      @relation(fields: [clientId], references: [id])
  startedAt   DateTime?
  endedAt     DateTime?
  status      VisitStatus @default(NOT_STARTED)
  transcript  String?
  report      Report?
  createdAt   DateTime    @default(now())
}

enum VisitStatus {
  NOT_STARTED
  RECORDING
  RECORDED
  SUMMARIZING
  DRAFT_READY
  SENT
}

model Report {
  id                String    @id @default(cuid())
  visitId           String    @unique
  visit             Visit     @relation(fields: [visitId], references: [id])
  meals             String
  medication        String
  notes             String
  medicationMorning Boolean   @default(false)
  medicationLunch   Boolean   @default(false)
  medicationEvening Boolean   @default(false)
  medicationBedtime Boolean   @default(false)
  medicationNone    Boolean   @default(false)
  aiRawJson         String?
  // D-24·DIF-2: 급여제공기록지 모양(CareRecord) JSON, 암호화. 1120 화면은 이 칸을 쓴다
  careRecord        String?
  // LAW-9: 급여제공기록지 서명(수급자·보호자, 요양보호사 선 좌표와 서명 불가 사유) JSON, 암호화
  signatures        String?
  wasEdited         Boolean   @default(false)
  shareToken        String    @unique @default(cuid())
  sentAt            DateTime?
  viewedAt          DateTime?
  viewCount         Int       @default(0)
  comments          Comment[]
}

// DIF-5 수급자 게시판 (D-15 261101.ver): 보낸 보고서가 게시글, 요양보호사·보호자는 댓글로 이야기한다
model Comment {
  id         String          @id @default(cuid())
  // 글은 보낸 보고서이거나 게시판에 올린 서류, 둘 중 하나
  reportId   String?
  report     Report?         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  documentId String?
  document   SharedDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author     String // "caregiver" | "guardian"
  body       String // LAW-11: 암호화
  createdAt  DateTime        @default(now())

  @@index([reportId])
  @@index([documentId])
}

// 게시판에 올린 서류 (DIF-4 진료 참고용 요약). 내용은 저장하지 않고 볼 때마다 그 기간의 기록으로 다시 만든다
model SharedDocument {
  id          String    @id @default(cuid())
  shareToken  String    @unique @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  caregiverId String
  kind        String // "summary"
  from        String // YYYY-MM-DD
  to          String // YYYY-MM-DD
  createdAt   DateTime  @default(now())
  comments    Comment[]

  @@index([clientId])
}
