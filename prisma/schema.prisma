generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Caregiver {
  id            String  @id @default(cuid())
  name          String
  licenseNumber String?
  kakaoId       String? @unique
  // OPS-1 체험 계정: demoExpiresAt이 지나면 수급자·방문 기록과 함께 지운다
  isDemo        Boolean   @default(false)
  demoExpiresAt DateTime?
  visits        Visit[]
  clients       Client[]
}

model Client {
  id                     String   @id @default(cuid())
  name                   String
  age                    Int?
  gender                 String?
  allergies              String?
  medicalHistory         String?
  medicationNotes        String?
  personalNotes          String?
  guardianName           String
  guardianRelation       String   @default("기타")
  guardianPhone          String?
  careRegistrationNumber String?
  careGrade              String?
  phone                  String?
  scheduleLabel          String?
  isActive               Boolean  @default(true)
  purgeAt                DateTime?
  // SEC-2: 담당 요양보호사. 1120 화면은 이 값으로 거른다. 옛 화면이 만든 수급자는 비어 있을 수 있다
  caregiverId            String?
  caregiver              Caregiver? @relation(fields: [caregiverId], references: [id])
  visits                 Visit[]
}

model Visit {
  id          String      @id @default(cuid())
  caregiverId String
  caregiver   Caregiver   @relation(fields: [caregiverId], references: [id])
  clientId    String
  client      Client      @relation(fields: [clientId], references: [id])
  startedAt   DateTime?
  endedAt     DateTime?
  status      VisitStatus @default(NOT_STARTED)
  transcript  String?
  report      Report?
  createdAt   DateTime    @default(now())
}

enum VisitStatus {
  NOT_STARTED
  RECORDING
  RECORDED
  SUMMARIZING
  DRAFT_READY
  SENT
}

model Report {
  id         String    @id @default(cuid())
  visitId    String    @unique
  visit      Visit     @relation(fields: [visitId], references: [id])
  meals      String
  medication String
  notes      String
  medicationMorning Boolean @default(false)
  medicationLunch   Boolean @default(false)
  medicationEvening Boolean @default(false)
  medicationBedtime Boolean @default(false)
  medicationNone    Boolean @default(false)
  aiRawJson  String?
  // D-24·DIF-2: 급여제공기록지 모양(CareRecord) JSON, 암호화. 1120 화면은 이 칸을 쓴다
  careRecord String?
  wasEdited  Boolean   @default(false)
  shareToken String    @unique @default(cuid())
  sentAt     DateTime?
  viewedAt   DateTime?
  viewCount  Int       @default(0)
}
